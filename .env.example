PORT=8100
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=praxxxxxxxxxx
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d
ADMIN_NAME=Portal Administrator
ADMIN_CONTACT=9xxxxxxxxx
ADMIN_PASSWORD=vxxxxxxxxx
FRONTEND_ORIGINS=http://localhost:5174,http://localhost:5173
NODE_ENV=development

# DigitalOcean Spaces / S3-compatible object storage
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=your-bucket-name
SPACES_ACCESS_KEY=your-access-key
SPACES_SECRET_KEY=your-secret-key

# Brevo HTTPS API / email verification
# Brevo API keys are used over HTTPS (port 443); no SMTP/cPanel settings are required.
# Keep the real API key only in the server .env file. Never commit or share it.
# If Brevo Authorized IPs are enabled, authorize the public IP of every machine/server
# that will make API calls (for production, authorize the DigitalOcean Droplet IP).
BREVO_API_KEY=PASTE_YOUR_BREVO_API_KEY_HERE
BREVO_FROM_EMAIL=vikalpafoundationtrust@vikalpa.org.in
BREVO_FROM_NAME=Vikalpa Foundation Trust
